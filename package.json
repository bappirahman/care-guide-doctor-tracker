{
  "name": "doctor-tracker",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "turbo run seed --filter=api",
    "seed:admin": "turbo run seed:admin --filter=api",
    "db:reset": "turbo run seed --filter=api -- --reset",
    "format": "prettier --write apps packages scripts .github \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check apps packages scripts .github \"*.{json,md,yml,yaml}\"",
    "clean": "node scripts/clean.mjs",
    "clean:build": "node scripts/clean.mjs --keep-deps",
    "fresh": "node scripts/clean.mjs && pnpm install --frozen-lockfile && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@doctor-tracker/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  },
  "prettier": "@doctor-tracker/config/prettier",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  }
}
