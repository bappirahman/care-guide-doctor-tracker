# Optional overrides for docker compose. Copy to .env next to docker-compose.yml.
# Every value has a working default, so this file is only needed to change something.

# Host ports
WEB_PORT=3000
API_PORT=4000
MONGO_PORT=27017

LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# Optional Google sign-in. Leave the client id and secret empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
ADMIN_EMAILS=

SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=DemoAdmin#2026
