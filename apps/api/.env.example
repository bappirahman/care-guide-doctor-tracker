NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/doctor-tracker

# The only origin allowed by CORS, and the base for the Google redirect URI.
WEB_ORIGIN=http://localhost:3000

# Access tokens are short-lived JWTs; refresh tokens are opaque and rotated on every use.
# Generate a secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Defaults to true when NODE_ENV=production. Safari refuses Secure cookies on http://localhost.
COOKIE_SECURE=false

# Optional. Leave all three empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Comma-separated emails allowed to sign in with Google without an existing account.
ADMIN_EMAILS=

# Demo admin created by the seed script.
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=DemoAdmin#2026
